# Copy this file to .env in the project root and fill in your credentials.
# Existing terminal environment variables take precedence over this file.

# Required for model calls
OPENAI_API_KEY=

# OpenAI-compatible API endpoint and model
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Required for accessing the target GitHub repository
GITHUB_TOKEN=
